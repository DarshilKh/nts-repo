# Copy to .env.local for local dev. On Vercel add these under
# Project -> Settings -> Environment Variables, then redeploy.
# Server-only: never prefix these with NEXT_PUBLIC_.

# SMTP account that SENDS the mail (a mailbox on your mail host).
SMTP_HOST=
SMTP_PORT=
# true for port 465, false for 587 (defaults to true when the port is 465)
SMTP_SECURE=true
SMTP_USER=xxxxx
SMTP_PASS=your-mailbox-password-or-app-password

# Where form submissions are delivered (defaults to sales@networktoll.com).
MAIL_TO=xxxxxx
# Optional. Most providers require this to be the SMTP_USER mailbox.
# MAIL_FROM="Network Toll website <sales@networktoll.com>"
